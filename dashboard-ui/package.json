    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^26.1.0",
    "react-test-renderer": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
