{
  "name": "@hydraterm/signaling-broker-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Reusable Hydra content-blind signaling broker; no hosted account or server composition.",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/domain/signaling.d.ts",
      "import": "./dist/domain/signaling.js"
    },
    "./ports": {
      "types": "./dist/domain/signaling-ports.d.ts"
    },
    "./types": {
      "types": "./dist/domain/types.d.ts"
    }
  },
  "scripts": {
    "test": "vitest run test/signaling-port.test.ts --maxWorkers 2",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.core-build.json && node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\""
  },
  "devDependencies": {
    "@types/node": "22.20.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
