{
  "name": "@hydraterm/remote-browser-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Hydra Remote browser controller, terminal rendering, protocol and transport engine; injectable authority, not the hosted account UI or a turnkey service.",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "files": [
    "dist",
    "types",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types/bridge/webrtc-bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./signaling": {
      "types": "./types/bridge/signaling-contract.d.ts",
      "import": "./dist/signaling.js"
    },
    "./refusal": {
      "types": "./types/bridge/setup-refusal-contract.d.ts",
      "import": "./dist/refusal.js"
    },
    "./transport": {
      "types": "./types/bridge/remote-transport.d.ts",
      "import": "./dist/transport.js"
    },
    "./controller": {
      "types": "./types/bridge/remote-client.d.ts",
      "import": "./dist/controller.js"
    },
    "./session": {
      "types": "./types/bridge/remote-session.d.ts",
      "import": "./dist/session.js"
    },
    "./auth": {
      "types": "./types/bridge/auth-contract.d.ts",
      "import": "./dist/auth.js"
    },
    "./identity": {
      "types": "./types/bridge/device-identity.d.ts",
      "import": "./dist/identity.js"
    },
    "./passkey": {
      "types": "./types/bridge/passkey.d.ts",
      "import": "./dist/passkey.js"
    },
    "./signaling-http": {
      "types": "./types/bridge/signaling-client.d.ts",
      "import": "./dist/signaling-http.js"
    },
    "./relay": {
      "types": "./types/bridge/relay-credential-cache.d.ts",
      "import": "./dist/relay.js"
    },
    "./layout": {
      "types": "./types/bridge/remote-layout-cloud.d.ts",
      "import": "./dist/layout.js"
    },
    "./protocol": {
      "types": "./types/protocol/control-messages.d.ts",
      "import": "./dist/protocol.js"
    },
    "./terminal-protocol": {
      "types": "./types/protocol/web-protocol.d.ts",
      "import": "./dist/terminal-protocol.js"
    },
    "./grid": {
      "types": "./types/terminal/grid-renderer.d.ts",
      "import": "./dist/grid.js"
    },
    "./input": {
      "types": "./types/terminal/input-encoder.d.ts",
      "import": "./dist/input.js"
    },
    "./viewport": {
      "types": "./types/terminal/viewport.d.ts",
      "import": "./dist/viewport.js"
    },
    "./selection": {
      "types": "./types/terminal/selection-controller.d.ts",
      "import": "./dist/selection.js"
    },
    "./theme": {
      "types": "./types/terminal/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./providers": {
      "types": "./types/model/agent-provider-core.d.ts",
      "import": "./dist/providers.js"
    }
  },
  "scripts": {
    "test": "vitest run --maxWorkers 2",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --config vite.config.ts && tsc --project tsconfig.core-build.json && node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\""
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.26"
  }
}
