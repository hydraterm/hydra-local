{
  "name": "@hydraterm/remote-browser-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Reusable Hydra WebRTC transport core; not a complete Remote application.",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.23.1",
    "npm": "10.9.8"
  },
  "files": [
    "dist",
    "types",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./types/bridge/webrtc-bridge.d.ts",
      "import": "./dist/bridge.js"
    },
    "./signaling": {
      "types": "./types/bridge/signaling-contract.d.ts",
      "import": "./dist/signaling.js"
    },
    "./refusal": {
      "types": "./types/bridge/setup-refusal-contract.d.ts",
      "import": "./dist/refusal.js"
    },
    "./transport": {
      "types": "./types/bridge/remote-transport.d.ts",
      "import": "./dist/transport.js"
    }
  },
  "scripts": {
    "test": "vitest run --maxWorkers 2 --minWorkers 1",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build --config vite.config.ts && tsc --project tsconfig.core-build.json && node -e \"require('node:fs').copyFileSync('../LICENSE', 'LICENSE')\""
  },
  "devDependencies": {
    "@types/node": "26.0.1",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
